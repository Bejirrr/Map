    local isHwidBanned = false
    
    pcall(function()
        -- Try modern Junkie runtime variables (JD_*) first
        if JD_IS_PREMIUM ~= nil then
            isPremium = JD_IS_PREMIUM or false
        end
        if JD_EXPIRES_AT ~= nil then
            expiresAt = JD_EXPIRES_AT
