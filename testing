        if JD_IS_HWID_BANNED ~= nil then
            isHwidBanned = JD_IS_HWID_BANNED or false
        end
        
        -- Fallback to JunkieCore if JD_* variables are not set
        if not isPremium and not expiresAt and JunkieCore then
            isPremium = JunkieCore.GetIsPremium() or false
            expiresAt = JunkieCore.GetExpiresAt()
            discordId = JunkieCore.GetDiscordId()
            createdAt = JunkieCore.GetCreatedAt()
            serviceName = JunkieCore.GetServiceName()
            isInvalidated = JunkieCore.GetIsInvalidated() or false
            isHwidBanned = JunkieCore.GetIsHwidBanned() or false
        end
    end)
    
    if not isPremium and userData.isVIP then
