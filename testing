                        valueLabel.Text = tostring(value)
                        
                        return value
                    end
                end)
                
                return {
                    GetValue = function()
                        return math.floor((sliderFill.Size.X.Scale) * 255)
                    end,
                    SetValue = function(value)
                        sliderFill.Size = UDim2.new(value / 255, 0, 1, 0)
