    blur.Image = "rbxasset://textures/ui/GuiImagePlaceholder.png"
    blur.ImageTransparency = 0.95
    blur.ScaleType = Enum.ScaleType.Tile
    blur.TileSize = UDim2.new(0, 100, 0, 100)
    blur.ZIndex = frame.ZIndex - 1
    blur.Parent = frame
    
    return blur
end

