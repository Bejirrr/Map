local TweenPresets = {
    Fast = TweenInfo.new(0.15, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
    Medium = TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.Out),
    Smooth = TweenInfo.new(0.4, Enum.EasingStyle.Sine, Enum.EasingDirection.Out),
}

local function CreateTween(instance, properties, tweenInfo)
    tweenInfo = tweenInfo or TweenPresets.Fast
    local tween = TweenService:Create(instance, tweenInfo, properties)
    tween:Play()
    return tween
end

local function ApplyGlassmorphism(frame)
    frame.BackgroundTransparency = 0.3
    
    local blur = Instance.new("ImageLabel")
    blur.Name = "GlassBlur"
    blur.Size = UDim2.new(1, 0, 1, 0)
    blur.Position = UDim2.new(0, 0, 0, 0)
