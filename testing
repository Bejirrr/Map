    end
    
    if expiresAt and (expiresAt <= 0 or type(expiresAt) ~= "number") then
        expiresAt = nil
    end
    
    -- Detect if timestamp is in seconds or milliseconds
    -- Timestamps after year 2000 in seconds: > 946684800
    -- Timestamps after year 2000 in milliseconds: > 946684800000
    local function normalizeTimestamp(timestamp)
        if not timestamp or type(timestamp) ~= "number" or timestamp <= 0 then
            return nil
        end
        -- If timestamp is less than 10 billion, it's in seconds (before year 2286)
        -- If timestamp is greater, it's in milliseconds
        if timestamp < 10000000000 then
            return timestamp * 1000  -- Convert seconds to milliseconds
        else
            return timestamp  -- Already in milliseconds
        end
    end
    
