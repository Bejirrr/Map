                    btnIconContainer.Name = "IconContainer"
                    btnIconContainer.Size = UDim2.new(0, 18, 0, 18)
                    btnIconContainer.Position = UDim2.new(0, 10, 0.5, -9)
                    btnIconContainer.BackgroundTransparency = 1
                    btnIconContainer.Parent = button
                    
                    LoadLucideIcon(btnIcon, btnIconContainer, Theme.TextColor)
                end
                
                local btnLabel = Instance.new("TextLabel")
                btnLabel.Size = UDim2.new(1, btnIcon and -40 or -20, 1, 0)
                btnLabel.Position = UDim2.new(0, btnIcon and 36 or 10, 0, 0)
                btnLabel.BackgroundTransparency = 1
                btnLabel.Text = btnTitle
                btnLabel.TextColor3 = Theme.TextColor
                btnLabel.TextSize = 13
                btnLabel.Font = Enum.Font.GothamSemibold
                btnLabel.TextXAlignment = Enum.TextXAlignment.Left
                btnLabel.Parent = button
                
                button.MouseButton1Click:Connect(function()
                    if btnCallback then
